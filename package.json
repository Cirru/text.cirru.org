{
  "name": "text-cirru-org",
  "version": "0.1.1",
  "description": "Cirru project index",
  "main": "index.js",
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "nanoid@npm:^4.0.1": "npm:5.1.16"
  },
  "scripts": {
    "w-dl": "calcit calcit.cirru --entry downloader --emit-path dl-out/ js -w",
    "c-dl": "calcit calcit.cirru --entry downloader --emit-path dl-out/ js",
    "compile": "mkdir -p data/files/Cirru && cp README.md data/files/Cirru/text.cirru.org.md && calcit calcit.cirru js",
    "build": "yarn compile && vite build",
    "dev": "yarn compile && vite"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Cirru/text.cirru.org.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "axios": "^1.20.0",
    "bottom-tip": "^0.1.5",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@calcit/procs": "0.32.0",
    "cirru-color": "^0.2.4",
    "feather-icons": "^4.29.1",
    "highlight.js": "^11.9.0",
    "remarkable": "^2.0.1"
  }
}
